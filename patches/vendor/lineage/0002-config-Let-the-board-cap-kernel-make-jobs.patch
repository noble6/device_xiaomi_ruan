From 5af9ca0b1d6519f7b90c5f27b42d3726c595a0fc Mon Sep 17 00:00:00 2001
From: noble6 <ruanproject01@gmail.com>
Date: Fri, 13 Nov 2026 10:56:19 +0000
Subject: [PATCH] config: Let the board cap kernel make jobs

KERNEL_JOBS limits the kernel build to that many jobs; without it the
kernel still uses every core. On shared build servers a full-width
kernel build next to Ninja can get the build killed.

Change-Id: I63ace2e179114c1c427e5ab68ad21986ccb78ce3
---
 config/BoardConfigKernel.mk | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/config/BoardConfigKernel.mk b/config/BoardConfigKernel.mk
index a3d8c874..7fa91c75 100644
--- a/config/BoardConfigKernel.mk
+++ b/config/BoardConfigKernel.mk
@@ -123,7 +123,8 @@ ifeq ($(TARGET_KERNEL_UNSAFE_DDK_HEADERS),true)
 endif
 
 # Add back threads, ninja cuts this to $(getconf _NPROCESSORS_ONLN)/2
-KERNEL_MAKE_FLAGS += -j$(shell getconf _NPROCESSORS_ONLN)
+# The board can cap this (KERNEL_JOBS) on shared build machines
+KERNEL_MAKE_FLAGS += -j$(if $(KERNEL_JOBS),$(KERNEL_JOBS),$(shell getconf _NPROCESSORS_ONLN))
 
 TOOLS_PATH_OVERRIDE := \
     HIP_PATH=none PERL5LIB=$(BUILD_TOP)/prebuilts/tools-lineage/common/perl-base
-- 
2.43.0

