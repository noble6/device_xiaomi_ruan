From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: noble6 <ruanproject01@gmail.com>
Date: Thu, 5 Nov 2026 13:00:00 +0530
Subject: [PATCH] arm64: Drop libjni_latinimegoogle

crDroid's LatinIME defines and requires this library too, so the build
fails with a packaging conflict, then with a duplicate module.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arm64/Android.bp      | 7 -------
 arm64/arm64-vendor.mk | 1 -
 2 files changed, 8 deletions(-)

diff --git a/arm64/Android.bp b/arm64/Android.bp
index c800163..1a83492 100644
--- a/arm64/Android.bp
+++ b/arm64/Android.bp
@@ -94,13 +94,6 @@ android_app_import {
     product_specific: true,
 }
 
-cc_prebuilt_library_shared {
-    name: "libjni_latinimegoogle",
-    srcs: ["proprietary/product/lib64/libjni_latinimegoogle.so"],
-    prefer: true,
-    product_specific: true,
-}
-
 prebuilt_apex {
     name: "com.google.android.gmssystem.prodvic",
     owner: "gapps",
diff --git a/arm64/arm64-vendor.mk b/arm64/arm64-vendor.mk
index 8880865..cc7d359 100644
--- a/arm64/arm64-vendor.mk
+++ b/arm64/arm64-vendor.mk
@@ -6,7 +6,6 @@ PRODUCT_SOONG_NAMESPACES += \
 
 PRODUCT_PACKAGES += \
     Phonesky \
-    libjni_latinimegoogle \
     com.google.android.gmssystem.prodvic
 
 ifeq ($(TARGET_IS_GROUPER),)
