+// gralloc usage bit for front buffered rendering: the producer draws into the buffer that is
+// on screen, so the same buffer can hold new pixels and the backdrop cache can't trust it.
+constexpr uint64_t kFrontBufferUsage = 1ULL << 32;
+
+// Size of pyramid level `level` for a blur rect of w x h (level 0 is 1/4 scale).
+int levelSize(int size, int level) {
+    return std::max(1, static_cast<int>(static_cast<float>(size) * BlurFilter::kInputScale) >>
+                               level);
+}
+
+} // namespace
+
+StrandBlurFilter::StrandBlurFilter(RuntimeEffectManager& effectManager)
+      : BlurFilter(effectManager),
+        mQuarterDownEffect(
+                effectManager
+                        .mKnownEffects[kKawaseBlurDualFilterV2_QuarterResDownSampleBlurEffect]),
+        mHalfDownEffect(
+                effectManager.mKnownEffects[kKawaseBlurDualFilterV2_HalfResDownSampleBlurEffect]),
+        mUpEffect(effectManager.mKnownEffects[kKawaseBlurDualFilterV2_UpSampleBlurEffect]),
+        mCacheEnabled(base::GetBoolProperty("ro.strand.blur.cache", true)) {
+    ALOGI("Strand blur: backdrop cache %s", mCacheEnabled ? "on" : "off");
+}
+
+StrandBlurFilter::LayerSnap StrandBlurFilter::snap(const LayerSettings& layer) {
+    LayerSnap s;
+    s.settings = layer;
+    if (const auto& buffer = layer.source.buffer.buffer) {
+        s.bufferId = buffer->getId();
+    }
+    s.settings.source.buffer.buffer = nullptr;
+    s.settings.source.buffer.fence = nullptr;
+    return s;
+}
+
+bool StrandBlurFilter::sameLayer(const LayerSnap& a, const LayerSnap& b) {
+    // operator== covers what SurfaceFlinger's own client composition cache compares; the
+    // rest are fields it leaves out that still change the pixels.
+    return a.bufferId == b.bufferId && a.settings == b.settings &&
+            a.settings.postProcessEffect == b.settings.postProcessEffect &&
+            a.settings.postProcessUniforms == b.settings.postProcessUniforms &&
+            a.settings.postProcessTarget == b.settings.postProcessTarget &&
+            a.settings.geometry.originalBounds == b.settings.geometry.originalBounds &&
+            a.settings.geometry.otherCrop == b.settings.geometry.otherCrop &&
+            a.settings.geometry.otherRoundedCornersRadii ==
+                    b.settings.geometry.otherRoundedCornersRadii &&
+            !(a.settings.borderSettings != b.settings.borderSettings) &&
+            !(a.settings.boxShadowSettings != b.settings.boxShadowSettings);
+}
+
+bool StrandBlurFilter::sameBackdrop(const Backdrop& a, const Backdrop& b) {
+    if (a.layers.size() != b.layers.size() || a.maxWhitePoint != b.maxWhitePoint ||
+        !(a.display == b.display) || a.display.targetHdrSdrRatio != b.display.targetHdrSdrRatio ||
+        a.display.tonemapStrategy != b.display.tonemapStrategy) {
+        return false;
+    }
+    for (size_t i = 0; i < a.layers.size(); i++) {
+        if (!sameLayer(a.layers[i], b.layers[i])) return false;
+    }
+    return true;
+}
+
+void StrandBlurFilter::setBackdrop(const DisplaySettings& display,
+                                   const std::vector<LayerSettings>& layers, size_t count) {
+    std::lock_guard<std::mutex> lock(mMutex);
+    mPending.display = display;
+    mPending.layers.clear();
+    mPending.maxWhitePoint = 0.f;
+    mPendingCacheable = mCacheEnabled && count <= layers.size();
+    if (!mPendingCacheable) return;
+
+    // The dimming ratio of the layers below depends on the brightest layer anywhere in the
+    // frame, so an HDR layer above the blur still changes the backdrop.
+    for (const auto& layer : layers) {
+        mPending.maxWhitePoint = std::max(mPending.maxWhitePoint, layer.whitePointNits);
+    }
+    mPending.layers.reserve(count);
+    for (size_t i = 0; i < count; i++) {
+        const auto& buffer = layers[i].source.buffer.buffer;
+        // Front buffered layers and layers drawn from command streams can change pixels
+        // without anything here changing.
+        if ((buffer && (buffer->getUsage() & kFrontBufferUsage)) ||
+            layers[i].renderCommandBuffer) {
+            mPendingCacheable = false;
+            mPending.layers.clear();
+            return;
+        }
+        mPending.layers.push_back(snap(layers[i]));
+    }
+}
+
+bool StrandBlurFilter::ensureSurface(SkiaGpuContext* context, sk_sp<SkSurface>& surface,
+                                     const SkImageInfo& info) {
+    if (surface && surface->imageInfo() == info) return true;
+    surface = context->createRenderTarget(info);
+    if (!surface) {
+        ALOGE("Strand blur: failed to create a %dx%d surface", info.width(), info.height());
+        return false;
+    }
+    return true;
+}
+
+void StrandBlurFilter::draw(const sk_sp<SkSurface>& dst, const sk_sp<SkImage>& src,
+                            const SkMatrix& srcToDst, const sk_sp<SkRuntimeEffect>& effect,
+                            float offset, float alpha) const {
+    const SkSamplingOptions linear(SkFilterMode::kLinear, SkMipmapMode::kNone);
+    sk_sp<SkShader> input = src->makeShader(SkTileMode::kClamp, SkTileMode::kClamp, linear,
+                                            &srcToDst);
+    SkPaint paint;
+    if (effect == mUpEffect && offset == 0.f) {
+        paint.setShader(std::move(input));
+        paint.setAlphaf(alpha);
+    } else {
+        SkRuntimeShaderBuilder builder(effect);
+        builder.child("child") = std::move(input);
+        if (effect == mUpEffect) {
+            builder.uniform("in_blurOffset") = offset;
+            builder.uniform("in_crossFade") = alpha;
+            builder.uniform("in_weightedCrossFade") = alpha * 0.125f;
+        }
+        paint.setShader(builder.makeShader(nullptr));
+    }
+    SkCanvas* canvas = dst->getCanvas();
+    if (alpha == 1.f) {
+        // Every pixel is overwritten: tell the GPU not to load the old contents.
+        canvas->discard();
+        paint.setBlendMode(SkBlendMode::kSrc);
+    } else {
+        paint.setBlendMode(SkBlendMode::kSrcOver);
+    }
+    canvas->drawPaint(paint);
+}
+
+void StrandBlurFilter::blurIntoSlot(Slot& slot, SkiaGpuContext* context, uint32_t blurRadius,
+                                    bool lite, const sk_sp<SkImage>& input, const SkIRect& rect,
+                                    bool reusePyramid) const {
+    // Same radius mapping as KawaseBlurDualFilterV2, so both look the same: 1/sqrt(3) matches
+    // Skia's Gaussian sigma, and the fraction of the last pass is blended in by alpha.
+    const float radius = blurRadius * 0.57735f;
+    float filterDepth = std::min(kMaxLevels - 1.0f, radius * kInputScale / 2.5f);
+    if (lite) filterDepth = std::min(filterDepth, 2.0f);
+    const int passes = std::min(kMaxLevels - 1, static_cast<int>(std::ceil(filterDepth)));
+
+    float sumSquaredR = 0, sumSquaredStep = 0;
+    for (int i = 0; i < passes; i++) {
+        const float alpha = std::min(1.0f, filterDepth - i);
+        sumSquaredR += powf(powf(2.0f, i - 1) * alpha * M_SQRT2, 2.0f);
+        sumSquaredStep += powf(powf(2.0f, i) * alpha, 2.0f);
+    }
+    const float step = sqrt(std::max(0.0f, powf(radius * kInputScale, 2) - sumSquaredR) /
+                            (sumSquaredStep == 0 ? 1 : sumSquaredStep));
+
+    const SkColorType colorType = slot.colorType;
+    auto infoFor = [&](int level) {
+        return SkImageInfo::Make(levelSize(rect.width(), level), levelSize(rect.height(), level),
+                                 colorType, kOpaque_SkAlphaType, input->refColorSpace());
+    };
+    auto fail = [&]() {
+        slot.valid = false;
+        slot.result = nullptr;
+    };
+
+    // Downsample pyramid: level 0 straight from the input, then halve.
+    int built = reusePyramid ? slot.depth : -1;
+    if (built < 0) {
+        SFTRACE_NAME("StrandBlur down0");
+        if (!ensureSurface(context, slot.down[0], infoFor(0))) return fail();
+        SkMatrix m = SkMatrix::Translate(-rect.fLeft, -rect.fTop);
+        m.postScale(slot.down[0]->width() / static_cast<float>(rect.width()),
+                    slot.down[0]->height() / static_cast<float>(rect.height()));
+        draw(slot.down[0], input, m, mQuarterDownEffect, 0.f, 1.f);
+        built = 0;
+    }
+    for (int i = built; i < passes; i++) {
+        SFTRACE_NAME("StrandBlur down");
+        if (!ensureSurface(context, slot.down[i + 1], infoFor(i + 1))) return fail();
+        const auto& src = slot.down[i];
+        const auto& dst = slot.down[i + 1];
+        draw(dst, src->makeTemporaryImage(),
+             SkMatrix::Scale(dst->width() / static_cast<float>(src->width()),
+                             dst->height() / static_cast<float>(src->height())),
+             mHalfDownEffect, 0.f, 1.f);
+    }
+    slot.depth = std::max(slot.depth * reusePyramid, passes);
+
+    // Upsample into separate targets so the pyramid stays valid for the next radius.
+    for (int i = passes - 1; i >= 0; i--) {
+        SFTRACE_NAME("StrandBlur up");
+        if (!ensureSurface(context, slot.up[i], infoFor(i))) return fail();
+        const auto& dst = slot.up[i];
+        const auto& src = (i == passes - 1) ? slot.down[i + 1] : slot.up[i + 1];
+        const float alpha = std::min(1.0f, filterDepth - i);
+        if (alpha < 1.f) {
+            // Partial last pass: blend over this level's own downsample, as V2 does.
+            draw(dst, slot.down[i]->makeTemporaryImage(), SkMatrix::I(), mUpEffect, 0.f, 1.f);
+        }
+        draw(dst, src->makeTemporaryImage(),
+             SkMatrix::Scale(dst->width() / static_cast<float>(src->width()),
+                             dst->height() / static_cast<float>(src->height())),
+             mUpEffect, step, alpha);
+    }
+
+    slot.result = passes > 0 ? slot.up[0] : slot.down[0];
+    slot.radius = blurRadius;
+    slot.lite = lite;
+    slot.valid = true;
+}
+
+sk_sp<SkImage> StrandBlurFilter::generateTemporaryImage(SkiaGpuContext* context,
+                                                        const DisplaySettings& display,
+                                                        const uint32_t radius,
+                                                        const sk_sp<SkImage> input,
+                                                        const SkRect& blurRect) const {
+    std::lock_guard<std::mutex> lock(mMutex);
+
+    // Leave out partial pixels at the edges, like V2.
+    SkIRect rect;
+    blurRect.roundIn(&rect);
+    if (rect.width() < 1) rect.fRight = rect.fLeft + 1;
+    if (rect.height() < 1) rect.fBottom = rect.fTop + 1;
+
+    const bool lite = mLiteProp.Get(false);
+    // 8-bit unless the input is F16, which only happens with HDR content on screen.
+    const SkColorType colorType = input->colorType() == kRGBA_F16_SkColorType
+            ? kRGBA_F16_SkColorType
+            : kRGBA_8888_SkColorType;
+    const bool cacheable = mPendingCacheable && !context->supportsProtectedContent() &&
+            mPending.display == display;
+
+    Slot* match = nullptr;
+    if (cacheable) {
+        for (auto& slot : mSlots) {
+            if (slot.valid && slot.context == context && slot.rect == rect &&
+                slot.colorType == colorType && sameBackdrop(slot.backdrop, mPending)) {
+                match = &slot;
+                break;
+            }
+        }
+    }
+    mUseCounter++;
+
+    if (match && match->radius == radius && match->lite == lite) {
+        SFTRACE_NAME("StrandBlur hit");
+        mHits++;
+        match->lastUse = mUseCounter;
+        return match->result->makeTemporaryImage();
+    }
+
+    Slot* slot = match;
+    if (slot) {
+        SFTRACE_NAME("StrandBlur partial");
+        mPartialHits++;
+        blurIntoSlot(*slot, context, radius, lite, input, rect, true);
+    } else {
+        mMisses++;
+        // Least recently used slot; uncacheable frames always use slot 0.
+        slot = &mSlots[0];
+        if (cacheable) {
+            for (auto& s : mSlots) {
+                if (!s.valid || s.lastUse < slot->lastUse) slot = &s;
+                if (!s.valid) break;
+            }
+        }
+        slot->valid = false;
+        slot->depth = 0;
+        slot->colorType = colorType;
+        blurIntoSlot(*slot, context, radius, lite, input, rect, false);
+        if (slot->valid && cacheable) {
+            slot->context = context;
+            slot->rect = rect;
+            slot->backdrop = mPending;
+        } else {
+            // Rendered, but not reusable
+            slot->valid = false;
+        }
+    }
+    slot->lastUse = mUseCounter;
+
+    if ((mUseCounter & 1023) == 0) {
+        ALOGD("Strand blur: %" PRIu64 " hits, %" PRIu64 " partial, %" PRIu64 " misses", mHits,
+              mPartialHits, mMisses);
+    }
+    if (!slot->result) {
+        // Allocation failed. Hand back the input; drawBlurRegion scales it by 4x, which is
+        // wrong but visible and recovers on the next frame.
+        return input;
+    }
+    return slot->result->makeTemporaryImage();
+}
+
+} // namespace skia
+} // namespace renderengine
+} // namespace android
