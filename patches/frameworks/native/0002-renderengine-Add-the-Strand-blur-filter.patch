+/**
+ * Dual filter Kawase blur that does as little GPU work as the frame allows.
+ *
+ * It draws the same picture as KawaseBlurDualFilterV2 (same shaders, same radius to step
+ * mapping), and adds:
+ *
+ * Backdrop cache. The blur input is everything drawn below the blurred layer. When those
+ * layers and the display settings are the same as in an earlier frame, the input pixels are
+ * too. The common case is the notification shade over a still home screen or app: only the
+ * shade's own content changes, so the blur is drawn once and then reused.
+ *  - same backdrop, same rect, same radius: nothing is rendered, the last result is returned.
+ *  - same backdrop and rect, new radius (shade or dialog fade in): the downsample pyramid is
+ *    kept and only the upsample passes run.
+ *
+ * Persistent opaque surfaces. Every pass renders to surfaces owned by the filter instead of
+ * scratch targets, in 8-bit opaque formats (no alpha blending read back, and compressible
+ * by the GPU) unless the input needs F16 for HDR. Downsample levels are kept apart from
+ * upsample levels so the pyramid survives a radius change.
+ *
+ * Lite mode. sys.strand.blur.lite=1 caps the pass count at two, which roughly halves the
+ * upsample cost at large radii. The Strand daemon sets it in battery and thermal profiles.
+ */
+class StrandBlurFilter : public BlurFilter {
+public:
+    static constexpr int kMaxLevels = 4;
+    static constexpr int kCacheSlots = 2;
+
+    explicit StrandBlurFilter(RuntimeEffectManager& effectManager);
+    ~StrandBlurFilter() override {}
+
+    void setBackdrop(const DisplaySettings& display, const std::vector<LayerSettings>& layers,
+                     size_t count) override;
+
+    sk_sp<SkImage> generateTemporaryImage(SkiaGpuContext* context, const DisplaySettings& display,
+                                          const uint32_t radius, const sk_sp<SkImage> blurInput,
+                                          const SkRect& blurRect) const override;
+
+private:
+    // A layer below the blur, without the parts that change every frame for the same pixels
