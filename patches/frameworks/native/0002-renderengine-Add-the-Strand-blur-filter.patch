+              const sk_sp<SkRuntimeEffect>& effect, float offset, float alpha) const;
+
+    sk_sp<SkRuntimeEffect> mQuarterDownEffect;
+    sk_sp<SkRuntimeEffect> mHalfDownEffect;
+    sk_sp<SkRuntimeEffect> mUpEffect;
+
+    const bool mCacheEnabled;
+    mutable android::base::CachedBoolProperty mLiteProp{"sys.strand.blur.lite"};
+
+    mutable std::mutex mMutex;
+    // Backdrop of the following generateTemporaryImage() calls, set by setBackdrop()
+    Backdrop mPending;
+    bool mPendingCacheable = false;
+
+    mutable Slot mSlots[kCacheSlots];
+    mutable uint64_t mUseCounter = 0;
+    mutable uint64_t mHits = 0, mPartialHits = 0, mMisses = 0;
+};
